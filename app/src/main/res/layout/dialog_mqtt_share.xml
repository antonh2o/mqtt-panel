<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/mqtt_share_enc_title"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_enc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb_aes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mqtt_share_enc_aes" />

        <RadioButton
            android:id="@+id/rb_nosecrets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mqtt_share_enc_nosecrets" />
    </RadioGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/mqtt_share_passphrase">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_passphrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/mqtt_share_topic_title"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_topic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb_perdev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mqtt_share_topic_perdev" />

        <RadioButton
            android:id="@+id/rb_common"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mqtt_share_topic_common" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/mqtt_share_pub_title"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_pub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb_manual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mqtt_share_pub_manual" />

        <RadioButton
            android:id="@+id/rb_auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mqtt_share_pub_auto" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/mqtt_share_hint"
        android:textSize="12sp" />
</LinearLayout>
