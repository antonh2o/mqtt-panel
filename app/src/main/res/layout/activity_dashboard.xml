<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Версия сборки — в полосе статус-бара (инсеты подставляет DashboardActivity) -->
    <TextView
        android:id="@+id/tv_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:textSize="11sp"
        android:textColor="?android:attr/textColorSecondary" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:elevation="2dp"
        app:title="@string/title_panels" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/panel_list_empty"
            android:textSize="16sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_widgets"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- Строка 1: Подключение + Перемещение -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_connect"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/connect"
                android:textSize="12sp"
                app:icon="@drawable/ic_play"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_move"
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/move_mode"
                android:textSize="12sp"
                android:contentDescription="@string/move_mode"
                app:icon="@drawable/ic_move"
                app:iconGravity="textStart"
                app:iconSize="16dp" />

        </LinearLayout>

        <!-- Строка 2: Сканер + Добавить -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_scan"
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/scan"
                android:textSize="12sp"
                app:icon="@drawable/ic_mqtt"
                app:iconGravity="textStart"
                app:iconSize="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_panel"
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/add"
                android:textSize="12sp"
                android:contentDescription="@string/add_panel"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconSize="16dp" />

        </LinearLayout>

        <!-- Строка 3: статус соединения + время в сети (тап — подключить) -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:text="@string/disconnected"
            android:textSize="12sp"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground" />

    </LinearLayout>

</LinearLayout>
