<?xml version="1.0" encoding="utf-8"?>
<!-- Время последней передачи КАК ЧАСТЬ ЛЕГЕНДЫ мультиграфика: нижней строкой
     той же плашки. Своего фона/рамки нет — фон общий у контейнера
     chart_overlay_box, отдельная плашка времени на мультиграфике не выводится -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tv_time"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:paddingTop="1dp"
    android:textSize="9sp"
    android:textColor="?android:attr/textColorSecondary"
    android:maxLines="1"
    android:visibility="gone" />
