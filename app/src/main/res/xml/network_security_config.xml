<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext разрешён осознанно: (1) api.narodmon.ru — некоторые сети (в т.ч.
  мобильные операторы) блокируют 443 до него, HTTPS→HTTP fallback NarodmonApi —
  единственный рабочий путь; (2) Grafana дома часто живёт на http://192.168.x.x —
  адрес пользователь вводит в настройках, домен нельзя добавить в рантайме.
  У MQTT-подключений открытый TCP и раньше не ограничивался этой политикой.
  HTTPS остаётся рекомендуемым путём (домен + reverse proxy).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
