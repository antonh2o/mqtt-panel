<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/action_scan"
        android:icon="@drawable/ic_mqtt"
        android:title="@string/scan"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_add"
        android:icon="@drawable/ic_add"
        android:title="@string/add"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_move"
        android:icon="@drawable/ic_move"
        android:title="@string/move_mode"
        app:showAsAction="never" />

    <!-- Фильтр «только избранное» — только для подключений Народного Мониторинга
         (включается/скрывается в onPrepareOptionsMenu). always, а не ifRoom:
         на узком экране (590x1280) ifRoom-звёздочка уезжала в ⋮-меню -->
    <item
        android:id="@+id/action_favorites"
        android:icon="@drawable/ic_star_outline"
        android:title="@string/favorites_filter"
        app:showAsAction="always" />

    <!-- Блокировка дашборда — видимой иконкой ВСЕГДА слева от ⋮: она же и
         индикатор режима (закрытый замок яркий = правки запрещены) -->
    <item
        android:id="@+id/action_lock"
        android:icon="@drawable/ic_lock"
        android:title="@string/lock_mode"
        app:showAsAction="always" />

</menu>
